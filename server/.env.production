# ==========================================
# BACKEND PRODUCTION CONFIGURATION (Express + MongoDB)
# Subdomain: specs-stock.gemshine.tech
# Server Port: 5028
# ==========================================
PORT=5028
NODE_ENV=production
CLIENT_URL=https://specs-stock.gemshine.tech

# MongoDB Local VPS Database (Installed on VPS)
MONGODB_URI=mongodb://127.0.0.1:27017/specs_stock_db
MONGODB_DB_NAME=specs_stock_db

# Local JSON Store Backup / Fallback
DATA_FILE_PATH=./server/data/db.json
