{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview --port=5173",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'dist-server', 'server.js'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\"",
    "lint": "tsc --noEmit",
    "server": "tsx watch server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:prod": "node dist-server/index.js",
    "dev:all": "concurrently -k -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server:dev\"",
    "start": "node dist-server/index.js",
    "client": "vite --port=5173 --host=0.0.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.11.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
